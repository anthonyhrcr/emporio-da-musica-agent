# Any OpenAI-compatible endpoint works. Default: local Ollama, no key needed.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.2
# qwen3 "thinks" by default; off keeps replies fast in a chat channel.
LLM_DISABLE_THINKING=true

# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini  LLM_API_KEY=sk-...
# Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.0-flash  LLM_API_KEY=...

# Optional: freeze the store clock (ISO, Campo Grande time) for reproducible runs.
# STORE_NOW=2026-03-25T10:30
